{
  "name": "@pdz/calc",
  "version": "0.1.0",
  "description": "Pokémon DraftZone damage calculator - a probability distribution over resulting battle states.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumarisX/dmg.git"
  },
  "main": "./build/cjs/index.js",
  "types": "./build/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@pkmn/data": "^0.10.11"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-typescript": "^7.23.3",
    "@pkmn/dex": "^0.10.11",
    "@pkmn/eslint-config": "^6.6.0",
    "@pkmn/mods": "^0.10.11",
    "@pkmn/sim": "^0.10.11",
    "@smogon/calc": "^0.10.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.3",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "lint": "eslint --cache src --ext ts",
    "fix": "eslint --fix src --ext ts",
    "typecheck": "tsc -p . --noEmit",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-module-type.mjs cjs commonjs",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/write-module-type.mjs esm module",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "test": "jest --runInBand",
    "test:integration": "npm run test && node integration",
    "prepare": "npm run build"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "node_modules/",
      "build/"
    ],
    "coveragePathIgnorePatterns": [
      "node_modules/",
      "build/",
      "src/test/helpers/"
    ],
    "coverageDirectory": ".coverage"
  },
  "babel": {
    "presets": [
      "@babel/preset-typescript",
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  },
  "eslintConfig": {
    "extends": "@pkmn",
    "overrides": [
      {
        "files": [
          "src/mechanics/*.ts",
          "!src/test/mechanics/index.ts"
        ],
        "rules": {
          "consistent-return": "off",
          "max-len": "off"
        }
      },
      {
        "files": [
          "src/test/mechanics/*.ts"
        ],
        "rules": {
          "max-len": "off"
        }
      },
      {
        "files": [
          "src/result.ts"
        ],
        "rules": {
          "@typescript-eslint/prefer-for-of": "off"
        }
      },
      {
        "files": [
          "src/utils.ts"
        ],
        "rules": {
          "@typescript-eslint/no-this-alias": "off"
        }
      },
      {
        "files": [
          "src/**/*.ts"
        ],
        "rules": {
          "import/order": "off",
          "@typescript-eslint/restrict-template-expressions": 0,
          "@typescript-eslint/ban-types": [
            "error",
            {
              "types": {
                "object": false,
                "{}": false,
                "Function": false
              },
              "extendDefaults": true
            }
          ]
        }
      }
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "printWidth": 150,
    "bracketSpacing": false,
    "arrowParens": "avoid",
    "space-in-parens": [
      "error",
      "never"
    ]
  }
}
